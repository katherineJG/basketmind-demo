# BasketMind dashboard. Build from the repository root: docker build -f deployment/Dockerfile.dashboard .
# It only talks to the API over HTTP, so it needs no torch and none of the project's ML code.
FROM python:3.12-slim

RUN pip install --no-cache-dir streamlit plotly pandas httpx

WORKDIR /app
COPY dashboard ./dashboard

ENV BASKETMIND_API_URL=http://api:8000 PYTHONUNBUFFERED=1
RUN useradd --create-home app
USER app
EXPOSE 8501
CMD ["streamlit", "run", "dashboard/app.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true"]
